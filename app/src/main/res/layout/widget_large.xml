<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Akış"
            android:textColor="@color/widget_fg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Kapalı"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/w_power_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_btn_off">

        <ImageView
            android:id="@+id/w_power"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Aç / kapat"
            android:padding="10dp"
            android:src="@drawable/ic_w_power"
            android:tint="@color/widget_fg" />
    </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Şu an bir şey oynatılmıyor"
        android:textColor="@color/widget_fg"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/w_progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progressBackgroundTint="@color/widget_tonal"
        android:progressTint="@color/widget_accent" />

    <LinearLayout
        android:id="@+id/w_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/w_voldown"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Sesi kıs"
            android:src="@drawable/ic_w_vol_down"
            android:tint="@color/widget_fg" />
        <ImageButton
            android:id="@+id/w_rew"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="10 sn geri"
            android:src="@drawable/ic_w_rewind"
            android:tint="@color/widget_fg" />
        <ImageButton
            android:id="@+id/w_play"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Oynat / duraklat"
            android:src="@drawable/ic_w_play"
            android:tint="@color/widget_fg" />
        <ImageButton
            android:id="@+id/w_fwd"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="30 sn ileri"
            android:src="@drawable/ic_w_forward"
            android:tint="@color/widget_fg" />
        <ImageButton
            android:id="@+id/w_stop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Durdur"
            android:src="@drawable/ic_w_stop"
            android:tint="@color/widget_fg" />
        <ImageButton
            android:id="@+id/w_volup"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Sesi aç"
            android:src="@drawable/ic_w_vol_up"
            android:tint="@color/widget_fg" />
    </LinearLayout>
</LinearLayout>
